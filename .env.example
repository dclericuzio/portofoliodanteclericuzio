# Copy this file to .env.local and fill in your SMTP credentials.
# These are used by the contact form API route (app/api/contact/route.js).

# SMTP host (e.g. smtp.gmail.com, smtp.zoho.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com
# 465 for SSL, 587 for STARTTLS
SMTP_PORT=465
# The mailbox/account used to authenticate and send from
SMTP_USER=you@example.com
# App password / SMTP password (for Gmail use an App Password, not your login password)
SMTP_PASSWORD=your_app_password
# Inbox that receives the contact messages (optional; defaults to SMTP_USER)
CONTACT_TO=you@example.com
